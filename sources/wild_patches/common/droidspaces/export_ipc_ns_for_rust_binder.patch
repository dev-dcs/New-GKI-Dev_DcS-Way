From: @Dev_DcS
Subject: [PATCH] ipc: export init_ipc_ns/put_ipc_ns for the rust binder module

CONFIG_ANDROID_BINDER_IPC_RUST=m references both under #if CONFIG_IPC_NS.
Stock GKI ships IPC_NS off so Google never links them; once DroidSpaces
turns IPC_NS on, rust_binder.ko fails modpost (undefined). Export them.

diff --git a/ipc/msgutil.c b/ipc/msgutil.c
index c7be0c792..630610982 100644
--- a/ipc/msgutil.c
+++ b/ipc/msgutil.c
@@ -33,6 +33,7 @@ struct ipc_namespace init_ipc_ns = {
 	.ns.ops = &ipcns_operations,
 #endif
 };
+EXPORT_SYMBOL_GPL(init_ipc_ns);
 
 struct msg_msgseg {
 	struct msg_msgseg *next;
diff --git a/ipc/namespace.c b/ipc/namespace.c
index 4df91ceee..c075e7b8d 100644
--- a/ipc/namespace.c
+++ b/ipc/namespace.c
@@ -207,6 +207,7 @@ void put_ipc_ns(struct ipc_namespace *ns)
 			schedule_work(&free_ipc_work);
 	}
 }
+EXPORT_SYMBOL_GPL(put_ipc_ns);
 
 static inline struct ipc_namespace *to_ipc_ns(struct ns_common *ns)
 {
