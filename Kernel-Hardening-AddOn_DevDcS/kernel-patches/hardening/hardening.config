# @Dev_DcS - extra kernel hardening (config side).
#
# Appended onto gki_defconfig by build-finasu-mosey.yml (block 2b-hard) and
# resolved with olddefconfig. All three are codegen / instrumentation only -
# they do NOT change the KMI symbol list or any module-visible struct, so stock
# vendor modules still load. Defaults stay safe; nothing here fights
# KernelSU / SUSFS / Zygisk.
#
# What the GKI defconfig already gives you (don't re-add): KASLR, CFI_CLANG,
# SHADOW_CALL_STACK, FORTIFY_SOURCE, HARDENED_USERCOPY, INIT_ON_ALLOC,
# SLAB_FREELIST_RANDOM+HARDENED, SHUFFLE_PAGE_ALLOCATOR, BUG_ON_DATA_CORRUPTION,
# UBSAN_TRAP, KFENCE, BPF_JIT_ALWAYS_ON.

# Zero call-used registers on function return: removes a big class of ROP-gadget
# reuse and leftover-register infoleaks. ~1% cost, clang-native.
CONFIG_ZERO_CALL_USED_REGS=y

# Turn linked-list corruption into a hard stop instead of a warning. Pairs with
# the CONFIG_BUG_ON_DATA_CORRUPTION already in the defconfig. 6.6 / 6.12 only
# (on 6.1 the equivalent lives behind CONFIG_DEBUG_LIST, which is heavier - the
# workflow skips it there).
CONFIG_LIST_HARDENED=y

# dmesg readable only with CAP_SYSLOG, enforced from boot (before init would set
# the sysctl). Keeps kernel log addresses out of unprivileged hands.
CONFIG_SECURITY_DMESG_RESTRICT=y
